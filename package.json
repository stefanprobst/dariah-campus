{
	"$schema": "https://www.schemastore.org/package",
	"name": "@dariah-eric/dariah-campus",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"analyze": "next experimental-analyze",
		"app:build": "next build --experimental-next-config-strip-types",
		"app:dev": "next dev --experimental-next-config-strip-types",
		"build": "run-s generate:handle cms:build generate:metadata-dump generate:api-docs app:build search:collections:update",
		"cms:build": "pnpm run cms:migrate --copy-media",
		"cms:migrate": "tsx ./scripts/cms/migrate.ts",
		"cms:verify": "tsx ./scripts/cms/verify.ts",
		"content:build": "dotenvx run -q -f ./.env.local --ignore MISSING_ENV_FILE -- tsx ./scripts/content/generate-content.ts build",
		"content:dev": "dotenvx run -q -f ./.env.local --ignore MISSING_ENV_FILE -- tsx ./scripts/content/generate-content.ts watch",
		"dev": "run-s cms:build app:dev",
		"dev:prepare": "sh ./scripts/dev/prepare.sh",
		"dev:services:down": "sh ./scripts/dev/services.sh stop",
		"dev:services:setup": "sh ./scripts/dev/setup.sh",
		"dev:services:up": "sh ./scripts/dev/services.sh start",
		"e2e:fixtures:create": "tsx ./scripts/e2e/create-fixture-content.ts create",
		"e2e:fixtures:remove": "tsx ./scripts/e2e/create-fixture-content.ts remove",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate:api-docs": "dotenvx run -q -f ./.env.local --ignore MISSING_ENV_FILE -- tsx ./scripts/api/generate-api-docs.ts",
		"generate:handle": "bash ./scripts/handle/create-handle.sh",
		"generate:metadata-dump": "dotenvx run -q -f ./.env.local --ignore MISSING_ENV_FILE -- tsx ./scripts/api/generate-metadata-dump.ts",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:code:fix": "oxlint --fix --report-unused-disable-directives --type-aware --type-check",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:mdx:dead-urls": "tsx ./scripts/content/lint.ts",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.css\" --cache --fix --ignore-path ./.gitignore",
		"prepare": "run-s dev:prepare types:prepare",
		"search:api-keys:generate": "dotenvx run -q -f ./.env.local --ignore MISSING_ENV_FILE -- tsx ./scripts/search/generate-search-api-keys.ts",
		"search:collections:create": "dotenvx run -q -f ./.env.local --ignore MISSING_ENV_FILE -- tsx ./scripts/search/create-collections.ts",
		"search:collections:reset": "dotenvx run -q -f ./.env.local --ignore MISSING_ENV_FILE -- tsx ./scripts/search/reset-collections.ts",
		"search:collections:update": "dotenvx run -q -f ./.env.local --ignore MISSING_ENV_FILE -- tsx ./scripts/search/update-search-index.ts",
		"start": "next start --experimental-next-config-strip-types",
		"test": "vitest run",
		"test:e2e": "playwright test --config ./e2e/playwright.config.ts",
		"test:watch": "vitest",
		"types:check": "tsc --noEmit",
		"types:prepare": "ENV_VALIDATION=\"disabled\" next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/mdx-lib": "^0.2.0",
		"@acdh-oeaw/openapi-nextjs": "^0.0.3",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@react-aria/utils": "^3.34.1",
		"@scalar/nextjs-api-reference": "^0.11.18",
		"@shikijs/transformers": "^4.5.0",
		"@stefanprobst/cms": "file:../../stefanprobst/cms/packages/cms",
		"@valibot/i18n": "^1.2.0",
		"@valibot/to-json-schema": "^1.8.0",
		"better-result": "^3.0.1",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"embla-carousel-react": "^8.6.0",
		"github-slugger": "^2.0.0",
		"hast-util-to-jsx-runtime": "^2.3.6",
		"image-size": "^2.0.2",
		"is-network-error": "^1.3.2",
		"lucide-react": "^1.45.0",
		"mdast-util-mdx-jsx": "^3.2.0",
		"mermaid": "^12.0.0",
		"next": "^16.3.5",
		"next-intl": "^4.14.4",
		"p-limit": "^7.3.2",
		"react": "^19.3.0",
		"react-aria": "^3.52.1",
		"react-aria-components": "^1.21.1",
		"react-dom": "^19.3.0",
		"react-schemaorg": "^2.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-smartypants": "^3.0.3",
		"server-nodejs-only": "^0.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.4",
		"shiki": "^4.4.3",
		"to-vfile": "^8.0.0",
		"typesense": "^3.0.6",
		"undici": "^8.10.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"uuid": "^14.0.2",
		"valibot": "^1.5.0",
		"vfile": "^6.0.3",
		"vfile-matter": "^5.0.1",
		"xast-util-feed": "^2.0.0",
		"xast-util-to-xml": "^4.0.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^2.24.1",
		"@playwright/test": "^1.63.0",
		"@react-types/shared": "^3.36.1",
		"@tailwindcss/turbopack": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.13.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.13.0",
		"axe-playwright": "^2.2.2",
		"dead-or-alive": "^1.0.5",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-playwright": "^2.11.0",
		"eslint-plugin-regexp": "^3.3.0",
		"hast-util-from-html": "^2.0.3",
		"hast-util-select": "^6.0.4",
		"is-in-ci": "^2.0.0",
		"is-online": "^12.0.2",
		"lefthook": "^2.1.12",
		"mdast-util-mdx-jsx": "^3.2.0",
		"npm-run-all2": "^9.0.3",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"oxlint-tsgolint": "^7.0.2001",
		"remark": "^15.0.1",
		"remark-mdx": "^3.1.1",
		"schema-dts": "^2.0.0",
		"stylelint": "^17.15.0",
		"stylelint-order": "^8.1.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-react-aria-components": "2.2.0",
		"tsx": "^4.23.13",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"unified-lint-rule": "^3.0.1",
		"vfile-reporter": "^8.1.1",
		"vitest": "^5.0.0"
	},
	"stylelint": {
		"extends": "./configs/stylelint/base.json"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.26.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^24.21.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@11.26.0"
}

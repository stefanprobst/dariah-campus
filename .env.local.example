# =====================================================================================================================
# environment variables for app
# =====================================================================================================================

# =====================================================================================================================
# app
# =====================================================================================================================

# local
# ---------------------------------------------------------------------------------------------------------------------

NEXT_PUBLIC_APP_BASE_URL="http://localhost:${PORT:-3000}"
# used to link to cms on preview branch deployments
NEXT_PUBLIC_APP_PRODUCTION_BASE_URL="http://localhost:${PORT:-3000}"
# imprint service
NEXT_PUBLIC_REDMINE_ID="16225"
# web crawlers
NEXT_PUBLIC_BOTS="disabled"
# validate environment variables
ENV_VALIDATION="enabled"

# =====================================================================================================================
# analytics
# =====================================================================================================================

# production
# ---------------------------------------------------------------------------------------------------------------------

# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_MATOMO_BASE_URL="https://matomo.acdh.oeaw.ac.at"
# NEXT_PUBLIC_MATOMO_ID=

# =====================================================================================================================
# search
# =====================================================================================================================

NEXT_PUBLIC_TYPESENSE_COLLECTION="dariah-campus"

# local
# ---------------------------------------------------------------------------------------------------------------------

NEXT_PUBLIC_TYPESENSE_HOST="localhost"
NEXT_PUBLIC_TYPESENSE_PORT="8108"
NEXT_PUBLIC_TYPESENSE_PROTOCOL="http"
NEXT_PUBLIC_TYPESENSE_SEARCH_API_KEY=# initialized in `dev:services:setup` script
TYPESENSE_ADMIN_API_KEY=# `openssl rand --hex 32`

# production
# ---------------------------------------------------------------------------------------------------------------------

# NEXT_PUBLIC_TYPESENSE_HOST="typesense.acdh.oeaw.ac.at"
# NEXT_PUBLIC_TYPESENSE_PORT="443"
# NEXT_PUBLIC_TYPESENSE_PROTOCOL="https"
# NEXT_PUBLIC_TYPESENSE_SEARCH_API_KEY=
# TYPESENSE_ADMIN_API_KEY=

# =====================================================================================================================
# cms
# =====================================================================================================================

# Without any of these, the cms reads and writes `.cms-migration` (see `pnpm cms:migrate`), and the development
# sign-in offers fixed accounts from `cms-config/users.json`.

# Signs sessions and upload urls; at least 32 characters.
# CMS_SECRET=
# Where the admin is served, if it differs from `NEXT_PUBLIC_APP_BASE_URL`.
# CMS_BASE_URL=

# Content in a GitHub repository, accessed as a GitHub App.
# CMS_CONTENT_REPO="dariah-eric/dariah-campus"
# CMS_CONTENT_BRANCH="main"
# CMS_GITHUB_APP_ID=
# CMS_GITHUB_APP_INSTALLATION_ID=
# CMS_GITHUB_APP_PRIVATE_KEY=
# Users and roles in a private repository.
# CMS_CONFIG_REPO="dariah-eric/dariah-campus-cms-config"

# Sign-in with GitHub (an OAuth app).
# CMS_GITHUB_CLIENT_ID=
# CMS_GITHUB_CLIENT_SECRET=

# Media in an S3-compatible bucket, images through imgproxy.
# CMS_S3_ENDPOINT=
# CMS_S3_BUCKET=
# CMS_S3_ACCESS_KEY_ID=
# CMS_S3_SECRET_ACCESS_KEY=
# CMS_S3_PUBLIC_URL=
# CMS_IMGPROXY_URL=
# CMS_IMGPROXY_KEY=
# CMS_IMGPROXY_SALT=

# =====================================================================================================================
# handle pid service
# =====================================================================================================================

# production
# ---------------------------------------------------------------------------------------------------------------------

HANDLE_CERT=
HANDLE_KEY=
HANDLE_PREFIX="21.11159"
HANDLE_PROVIDER="https://vm02.pid.gwdg.de:8004"
HANDLE_RESOLVER="https://hdl.handle.net/"
